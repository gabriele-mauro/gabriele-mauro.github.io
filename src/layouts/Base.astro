---
import '../styles/global.css';
import fontLatinNormal from '@fontsource-variable/stix-two-text/files/stix-two-text-latin-wght-normal.woff2?url';
import { ui } from '../site';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={fontLatinNormal} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#content">{ui.skipLink}</a>
    <div class="page">
      <slot />
    </div>
  </body>
</html>
